# ============================================================
# Complete Nova Unified All-Libraries Test (test_all_libs_unified.nova)
# Covers Core + Backend + Data + UI + App + Game + Mem + AI
# Runs on Interpreter (DEV) & Compiles to 6 Native Targets (PROD)
# ============================================================
import math
import time
import random
import server
import db
import auth
import log
import numpy as np
import pandas as pd
import chart
import viz
import app
import ui
import mem
import game
import render
import physics
import input
import asset
import ai

show "=================================================="
show "  NOVA A-TO-Z ALL LIBRARIES UNIFIED DEV/PROD SUITE"
show "=================================================="

# 1. CORE (Math, Time, Random)
show "--- 1. CORE MODULES ---"
rootVal = math.root(144)
powerVal = math.power(2, 8)
show "math.root(144):", rootVal
show "math.power(2, 8):", powerVal
show "time.date():", time.date()
randNum = random.int(1, 10)
show "random.int(1, 10):", randNum

# 2. BACKEND (Server, DB, Auth, Log)
show "--- 2. BACKEND MODULES ---"
log.info("Backend services initializing...")
myDb = db.open("nova_prod.db")
myDb.table("users", {name: "string", role: "string"})
rowId = myDb.insert("users", {name: "Thilak", role: "admin"})
show "Database inserted record ID:", rowId
pwdHash = auth.hash("SuperSecretNova2026")
show "Auth password hash generated:", pwdHash

# 3. DATA & AI (NumPy, Pandas, Chart, Viz, AI)
show "--- 3. DATA, AI & VISUALIZATION ---"
arr = np.array([1.5, 2.5, 3.5, 4.5, 5.5])
show "NumPy array mean:", arr.mean()
show "NumPy array sum:", arr.sum()

df = pd.DF()
df.addCol("scores", [95.0, 88.0, 92.0, 100.0])
show "Pandas DataFrame created with scores column"

denseNet = ai.dense(5, 1, "sigmoid")
aiPred = ai.forward(denseNet, arr)
show "AI neural network inference output:", aiPred

# 4. UI & MEMORY (App, UI, Zero-GC Mem)
show "--- 4. UI & ZERO-GC MEMORY ---"
mem.noGC()
particlePool = mem.pool(1000, "particle")
part = particlePool.get()
show "Zero-GC memory pool active item:", part
loginCard = ui.card("Welcome to Nova Unified", {padding: 24, theme: "dark"})
loginBtn = ui.btn("Launch Enterprise App")

# 5. GAME ENGINE (Render, Physics, Input, Asset, Game)
show "--- 5. DIRECT GPU 3D/2D GAME ENGINE ---"
gameWin = render.window(1920, 1080, "Nova Ultimate")
gameMesh = render.mesh("models/ship.obj")
gameMat = render.material({color: "gold", shader: "pbr", metallic: 0.95, roughness: 0.05})
ship = render.entity(gameMesh, gameMat)
cam = render.camera({fov: 90, pos: [0, 5, 10]})
render.draw(ship, cam)
render.present()

show "=================================================="
show "  A-TO-Z ALL NOVA LIBRARIES EXECUTED SUCCESSFULLY!"
show "=================================================="
